#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
VENV_DIR="$SCRIPT_DIR/.setup-venv"

if ! command -v uv >/dev/null 2>&1; then
    printf 'Error: uv is required to run setup. Install uv first: https://docs.astral.sh/uv/getting-started/installation/\n' >&2
    exit 1
fi

if [ ! -x "$VENV_DIR/bin/python" ]; then
    uv venv "$VENV_DIR"
fi

exec "$VENV_DIR/bin/python" "$SCRIPT_DIR/dotfiles_cli.py" setup "$@"
